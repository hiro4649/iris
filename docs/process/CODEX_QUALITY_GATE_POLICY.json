{
  "marker": "CODEX_QUALITY_HARNESS_FILE v0.6.5",
  "profile": "iris",
  "packageDirs": ["."],
  "missingScript": "fail",
  "allowedPaths": [],
  "blockedPaths": [".env", ".env.*", "**/*.pem", "**/*.p12", "**/*.pfx"],
  "highRiskPaths": ["src/", "test/", "docs/specs/", "IRIS_SPEC_AUTHORITY.md", "scripts/run-tests.js"],
  "diffScope": {
    "outOfScope": "fail",
    "blocked": "fail",
    "highRisk": "warn"
  },
  "riskKeywords": {
    "R3": [
      "IRIS",
      "IRIS_SPEC_AUTHORITY",
      "Phase",
      "candidate",
      "approved",
      "commit",
      "execution",
      "Core",
      "Adapter",
      "persistence",
      "secret",
      "admin"
    ],
    "R2": ["config", "workflow", "script", "dependency"]
  },
  "checks": [
    {
      "name": "IRIS config doctor",
      "type": "npmScript",
      "cwd": ".",
      "script": "dev:config:doctor",
      "profileRequired": true
    },
    {
      "name": "IRIS Phase27/P0 boundary guard fixture",
      "command": "node",
      "cwd": ".",
      "args": ["scripts/run-tests.js"],
      "env": {
        "IRIS_TEST_NAME_FILTER": "Phase00-27 addendum P0 boundary guard rejects direct candidates and internal canonical leakage"
      },
      "profileRequired": true
    },
    {
      "name": "npm test",
      "type": "npmScript",
      "cwd": ".",
      "script": "test",
      "envFlag": "CODEX_RUN_NPM_TEST",
      "missingScript": "skip"
    },
    {
      "name": "npm build",
      "type": "npmScript",
      "cwd": ".",
      "script": "build",
      "envFlag": "CODEX_RUN_NPM_BUILD",
      "missingScript": "skip"
    },
    {
      "name": "npm lint",
      "type": "npmScript",
      "cwd": ".",
      "script": "lint",
      "envFlag": "CODEX_RUN_NPM_LINT",
      "missingScript": "skip"
    },
    {
      "name": "npm smoke",
      "type": "npmScript",
      "cwd": ".",
      "script": "smoke",
      "envFlag": "CODEX_RUN_NPM_SMOKE",
      "missingScript": "skip"
    }
  ]
}
